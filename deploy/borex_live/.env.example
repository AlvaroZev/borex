# Copy to .env and fill in your values.
# restart-live.ps1 sets BOREX_MAIN_ROOT to the repo root automatically.

DATABASE_URL=postgresql://user:password@host:port/railway

# MT5 demo (use MASTER password, not investor)
MT5_LOGIN=
MT5_PASSWORD=
MT5_DEMO_SERVER=ICMarketsSC-Demo

# Prefer a portable MT5 install outside Program Files when possible
# MT5_PATH=C:\MT5\terminal64.exe
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional override (normally set by restart-live.ps1)
# BOREX_MAIN_ROOT=C:\borex
