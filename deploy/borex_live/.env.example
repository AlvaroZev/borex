# Primary: local Docker Postgres (docker compose up -d)
# Port 5433 avoids clashing with a host Postgres on 5432.
DATABASE_URL=postgresql://borex:borex@127.0.0.1:5433/borex_live

# Optional offsite mirror (Railway). Live trading never depends on this.
# DATABASE_BACKUP_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# MT5 demo account (use MASTER password, not investor)
MT5_LOGIN=
MT5_PASSWORD=
MT5_DEMO_SERVER=YourBroker-Demo

